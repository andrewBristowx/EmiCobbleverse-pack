{
	"chapter_group.4BD0F4C4DA544665.title": "Cocina"
	"chapter_group.0FD05755043B163E.title": "Oritech"
	"chapter_group.1936984355C6AD67.title": "Almacenamiento"
	"quest.2F03AC2F0B579310.title": "¡Bienvenido a EmiCobbleverse!"
	"quest.2F03AC2F0B579310.quest_subtitle": "Empieza aquí"
	"quest.2F03AC2F0B579310.quest_desc": [
		"&6Esta guía te enseña, paso a paso, los mods de &fcocina&6, &ftecnología (Oritech)&6 y &falmacenamiento (Tom's Storage)&6."
		""
		"• Cada capítulo (a la izquierda) es un mod. Las misiones se desbloquean en orden: las flechas muestran qué necesitas antes."
		"• Las misiones de objetos se completan solas al tener el objeto en el inventario; no se gasta."
		"• Para ver cómo se fabrica algo, pasa el ratón sobre el objeto en el inventario y pulsa &eR&f (recetas) o &eU&f (usos) en REI."
		"• Cada misión da un poco de experiencia al completarla."
	]
	"quest.54B0369E539A1087.title": "Cocina Pokémon"
	"quest.54B0369E539A1087.quest_desc": [
		"Cocina con la olla de Farmer's Delight y descubre los platos con bayas que dan efectos de Pokémon y de Minecraft."
		""
		"Capítulos: &eCocina básica&f y &ePlatos Pokémon&f."
	]
	"quest.14A79E536B40F774.title": "Tecnología: Oritech"
	"quest.14A79E536B40F774.quest_desc": [
		"Máquinas, energía y automatización. Con la integración de Cobblemon también fabrica objetos de Pokémon."
		""
		"Capítulos: &ePrimeros pasos&f, &eProcesamiento&f, &eEnergía&f, &eLogística&f, &eAutomatización&f y &eAvanzado&f."
		""
		"&aAviso:&f los minerales de Oritech solo aparecen en chunks nuevos; explora la zona nueva del mapa."
	]
	"quest.7D6FE158E67C868C.title": "Almacenamiento: Tom's Storage"
	"quest.7D6FE158E67C868C.quest_desc": [
		"Conecta tus cofres en una sola red y accede a todo desde una terminal."
		""
		"Capítulo: &eTom's Storage&f."
	]
	"chapter.329CA985584961E8.title": "Bienvenida"
	"quest.126108D94C5FFB3F.title": "Cuchillo de hierro"
	"quest.126108D94C5FFB3F.quest_desc": [
		"El cuchillo se usa sobre la tabla de picar para cortar ingredientes y obtener más cosas de los alimentos."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"Palo, lingote de hierro"
	]
	"quest.705148564D2D5AA5.title": "Tabla de picar"
	"quest.705148564D2D5AA5.quest_desc": [
		"Coloca la tabla en el suelo, pon un objeto encima y úsala con la herramienta adecuada (el cuchillo, por ejemplo)."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× tablones, 2× Palo"
	]
	"quest.3771D5B76E52960B.title": "Parrilla"
	"quest.3771D5B76E52960B.quest_desc": [
		"La parrilla es una fuente de calor. La olla necesita una fuente de calor justo debajo para cocinar."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× Ladrillos, 3× lingote de hierro, Hoguera"
	]
	"quest.323D9D47A93925AA.title": "Olla"
	"quest.323D9D47A93925AA.quest_desc": [
		"La olla es el centro de la cocina: pon hasta 6 ingredientes y, si el plato lo pide, un cuenco como recipiente. Debajo necesita calor (parrilla, hoguera, lava...)."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"5× lingote de hierro, 2× Ladrillo, Pala de madera, cubo de agua"
		""
		"&aTruco:&f al sacar un plato de cuenco hay que tener un cuenco en la mano."
	]
	"quest.1B993C9E7C9D6C84.title": "Sartén"
	"quest.1B993C9E7C9D6C84.quest_desc": [
		"La sartén cocina alimentos sobre la parrilla o una hoguera, sin necesidad de olla."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× lingote de hierro, Ladrillo"
	]
	"quest.430C33CCAE96354E.title": "Arroz"
	"quest.430C33CCAE96354E.quest_desc": [
		"El arroz crece en el agua. Cocínalo en la olla para obtener arroz cocido, base de los curris."
		""
		"&6Receta de crafteo&r &7(sin forma; en REI pulsa R sobre el objeto para verla)&f"
		"Panícula de arroz"
		""
		"&7Plántalo en tierra con agua encima (tierra de cultivo con una capa de agua).&f"
	]
	"quest.19D01C0EA298D419.title": "Arroz cocido"
	"quest.19D01C0EA298D419.quest_desc": [
		"Pon arroz en la olla (con calor debajo) y obtendrás arroz cocido. Lo necesitan los 18 curris de baya."
	]
	"quest.353B6CF3F27545D9.title": "Consejos de cocina"
	"quest.353B6CF3F27545D9.quest_desc": [
		"&6Antes de cocinar:&f"
		"• Usa la parrilla (o una hoguera) debajo de la olla."
		"• Los platos que se sirven en cuenco necesitan un cuenco en la mano al sacarlos de la olla."
		"• Mira la receta de cada plato en REI (R sobre el plato)."
		"• Los platos de EmiCobbleverse dan efectos de Minecraft y de Pokémon (CobbleCuisine)."
	]
	"chapter.74FDBFB9ADDE62C1.title": "Cocina básica"
	"chapter.74FDBFB9ADDE62C1.chapter_subtitle": [
		"Las herramientas de Farmer's Delight"
	]
	"quest.08F1296AA1C977F2.title": "Tu primer plato"
	"quest.08F1296AA1C977F2.quest_desc": [
		"Con la olla lista y arroz cocido, ya puedes preparar los platos de EmiCobbleverse."
		""
		"Cada plato se prepara en la olla y se completa al &ecomerlo&f."
		""
		"&aConsejo:&f las bayas se encuentran en los árboles de bayas de Cobblemon."
	]
	"quest.62F605F14A7D1083.title": "Curry de Baya Chilan (Normal)"
	"quest.62F605F14A7D1083.quest_desc": [
