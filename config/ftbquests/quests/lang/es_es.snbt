	"quest.1504C07FBC99967F.title": "Festín del Directo"
	"quest.1504C07FBC99967F.quest_desc": [
		"&6Ingredientes:&f diamante, manzana dorada, baya Enigma, hierba revividora, caramelo raro."
		"&6Efectos:&f Bono aleatorio de servidor 20 min (para todos) + Regeneración II, Absorción IV, EXP y captura 10 min. Máx. 3 seguidos y 60 min de enfriamiento."
		""
		"Cocínalo en la olla de Farmer's Delight."
		""
		"&aFestín del Directo:&f activa un bono aleatorio de servidor de 20 minutos para todos. Máximo 3 seguidos y 60 min de enfriamiento; si está en enfriamiento, el plato se devuelve."
	]
	"chapter.0C9996AE72CA0F98.title": "Platos Pokémon"
	"chapter.0C9996AE72CA0F98.chapter_subtitle": [
		"Recetas con bayas y efectos de Pokémon"
	]
	"quest.00BECF0C271ABC12.title": "Marco de máquina"
	"quest.00BECF0C271ABC12.quest_desc": [
		"Pieza estructural de Oritech. &7El mod indica que el tamaño máximo del marco se puede cambiar en su configuración.&f"
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"3× Barrotes de hierro, 2× lingote de níquel"
	]
	"quest.7D528301F64A154E.title": "Núcleo de máquina primitivo"
	"quest.7D528301F64A154E.quest_desc": [
		"Los núcleos de máquina tienen 7 niveles. Las máquinas multibloque indican qué núcleos necesitan; el nivel 1 es el primitivo."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"8× tablones, Mesa de trabajo"
	]
	"quest.5330BDDABE581643.title": "Núcleo de máquina básico"
	"quest.5330BDDABE581643.quest_desc": [
		"Núcleo básico: el siguiente nivel de núcleo."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"8× lingote de cobre, gema de lapislázuli"
	]
	"quest.798A237E59AF7DFE.title": "Núcleo de máquina mejorado"
	"quest.798A237E59AF7DFE.quest_desc": [
		"Núcleo mejorado."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"8× fibra de carbono, polvo de redstone"
	]
	"quest.707DAB56034C547D.title": "Núcleo de máquina avanzado"
	"quest.707DAB56034C547D.quest_desc": [
		"Núcleo avanzado."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"8× revestimiento reforzado, Compuesto endérico"
	]
	"quest.47E091EB7EDF3348.title": "Núcleo de máquina élite"
	"quest.47E091EB7EDF3348.quest_desc": [
		"Núcleo de élite."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"8× Lingote de adamantio, Motor de computación avanzada"
	]
