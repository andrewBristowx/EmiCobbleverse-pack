	"quest.00D518DFDC305633.title": "Marco de inventario"
	"quest.00D518DFDC305633.quest_desc": [
		"Los marcos conectan inventarios con el conector de inventarios, aunque haya huecos entre ellos. Se pueden pintar con el kit de pintura."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× palo, 4× tablones, cofre"
	]
	"quest.60250A560486E6EE.title": "Terminal de almacenamiento"
	"quest.60250A560486E6EE.quest_desc": [
		"Da acceso a todos tus objetos desde un solo lugar. Colócala encima de un inventario conectado."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× tablones, 2× Comparador de redstone, cofre, cristal, polvo de piedra luminosa"
	]
	"quest.467E30F951B70460.title": "Terminal de crafteo"
	"quest.467E30F951B70460.quest_desc": [
		"Como la terminal de almacenamiento, pero con una mesa de crafteo integrada."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× Mesa de trabajo, 4× gema de diamante, Terminal de almacenamiento"
	]
	"quest.7E500C9BD2332669.title": "Cable de inventario"
	"quest.7E500C9BD2332669.quest_desc": [
		"Conecta inventarios a larga distancia. Hay que unirlos con conectores de cable de inventario; el cable necesita un conector de inventarios."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× palo, 2× tablones, 2× trampilla, cofre"
	]
	"quest.3BACC719F0505F60.title": "Conector de cable de inventario"
	"quest.3BACC719F0505F60.quest_desc": [
		"Conecta un inventario a la red del cable. Usa el configurador de inventarios para filtrar."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"2× tablones, Cable de inventario, cofre, gema de cuarzo, gema de diamante, perla de ender"
	]
	"quest.3BB470584852F61C.title": "Proxy de inventario"
	"quest.3BB470584852F61C.quest_desc": [
		"Extiende la cara del bloque al que apunta."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"5× tablones, 3× trampilla, cofre"
	]
	"quest.7E36529C3946BE82.title": "Interfaz de inventario"
	"quest.7E36529C3946BE82.quest_desc": [
		"Da acceso al inventario del conector de inventarios al que está conectado (por ejemplo, para usar tolvas o tuberías con la red)."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× tablones, 3× trampilla, cofre, perla de ender"
	]
	"quest.1E7776A156B72829.title": "Tolva de inventario básica"
	"quest.1E7776A156B72829.quest_desc": [
		"Importa o exporta objetos de la red de inventarios. Clic derecho con un objeto para ponerle filtro; agáchate con la mano vacía para quitarlo."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"2× tablones, Cable de inventario, Tolva"
	]
	"quest.36794FB63D577D5F.title": "Emisor de nivel"
	"quest.36794FB63D577D5F.quest_desc": [
		"Emite una señal de redstone según el contenido de la red de inventarios (más o menos de cierta cantidad)."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"2× tablones, Antorcha de redstone, Cable de inventario, Comparador de redstone"
	]
	"quest.1618E23C4DA323C4.title": "Archivador"
	"quest.1618E23C4DA323C4.quest_desc": [
		"Guarda muchas variantes del mismo objeto."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× Piedra lisa, 3× cofre, 2× lingote de hierro"
	]
	"quest.01643C13F9E29435.title": "Caja abierta"
	"quest.01643C13F9E29435.quest_desc": [
		"Convierte el bloque que tiene delante en un inventario. &aCuidado:&f crea entidades de objeto."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"6× tablones, cofre, palo, trampilla"
	]
	"quest.4F4D1AB1D639D80C.title": "Filtro de objetos"
	"quest.4F4D1AB1D639D80C.quest_desc": [
		"Permite filtrar varios objetos, con o sin sus componentes."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× palo, 4× polvo de redstone, lana"
	]
	"quest.39439ABA1F6104B2.title": "Filtro de objetos polimórfico"
	"quest.39439ABA1F6104B2.quest_desc": [
		"Solo deja insertar objetos que ya existen en ese inventario."
	]
	"quest.785E8ACE7CE38A33.title": "Filtro de etiquetas"
	"quest.785E8ACE7CE38A33.quest_desc": [
		"Filtra usando etiquetas."
	]
	"quest.4DC2C91440590067.title": "Configurador de inventarios"
	"quest.4DC2C91440590067.quest_desc": [
		"Configura cómo interactúa cada inventario con el conector. Resalta los bloques pintados."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"marco de inventario, palo"
	]
	"quest.3CE76EAE8EE1567A.title": "Kit de pintura"
	"quest.3CE76EAE8EE1567A.quest_desc": [
		"Pinta los bloques para que combinen con lo que tienen alrededor."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"Cubo, Cubo con agua, dyes black, dyes blue, dyes green, dyes red, lana, palo"
	]
	"quest.30FEE0A7A9E3F3E4.title": "Terminal inalámbrica"
	"quest.30FEE0A7A9E3F3E4.quest_desc": [
		"Amplía tu alcance a la terminal. Alcance limitado en bloques."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"4× tablones, Catalejo, Comparador de redstone, cristal, perla de ender, polvo de piedra luminosa"
	]
	"quest.61E7A6C129F03946.title": "Terminal inalámbrica avanzada"
	"quest.61E7A6C129F03946.quest_desc": [
		"Agáchate y clic derecho sobre una terminal para vincularla. Un faro cerca de la terminal (radio de 8 bloques) amplía el alcance: con nivel suficiente funciona en toda la dimensión o entre dimensiones."
	]
