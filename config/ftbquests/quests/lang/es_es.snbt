	"quest.6CA84D02305EBB46.title": "Pulverizador"
	"quest.6CA84D02305EBB46.quest_desc": [
		"Muele lingotes y otros materiales y los convierte en polvo."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"5× Lingote de hierro, 2× Motor, bloque de cobre, lingote de níquel"
		""
		"&6Ejemplos de lo que hace&r"
		"• Lingote de adamantio → 1× Polvo de adamantio"
		"• materia orgánica → 1× Biomasa"
		"• Lingote de biometal → 1× Polvo de biometal"
	]
	"quest.5E936D36798FC1BB.title": "Forja de fragmentos"
	"quest.5E936D36798FC1BB.quest_desc": [
		"Hace un trabajo parecido al del pulverizador pero más rápido (sus recetas tardan menos). Con el complemento de rendimiento duplica los subproductos."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"5× placa de plástico, 2× Motor, Puerta de flujo, revestimiento reforzado"
		""
		"&6Ejemplos de lo que hace&r"
		"• Lingote de adamantio → 1× Polvo de adamantio"
		"• materia orgánica → 1× Biomasa"
		"• Lingote de biometal → 1× Polvo de biometal"
	]
	"quest.12E1AB887ECD125E.title": "Horno eléctrico"
	"quest.12E1AB887ECD125E.quest_desc": [
		"Horno eléctrico: funde y cocina objetos usando energía."
		""
