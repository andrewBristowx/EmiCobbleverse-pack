	"quest.6AD1E72BDDCD9319.quest_desc": [
		"Núcleo ultra."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"8× Lingote de duratium, Contenedor dudoso"
	]
	"quest.3CA5C3C1EF70B9E4.title": "Núcleo de máquina definitivo"
	"quest.3CA5C3C1EF70B9E4.quest_desc": [
		"Núcleo definitivo: el máximo nivel de núcleo."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"8× Prometheum, Superconductor"
	]
	"quest.77E3C6E392DFC7B2.title": "Lingote de acero"
	"quest.77E3C6E392DFC7B2.quest_desc": [
		"El acero es un material básico de Oritech: se hace con lingotes de hierro y carbón."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"2× carbón, 2× lingote de hierro"
	]
	"quest.486D2844E3A68BBA.title": "Lingote de electrum"
	"quest.486D2844E3A68BBA.quest_desc": [
		"El electrum se hace con lingotes de oro y polvo de redstone. Lo usan, por ejemplo, las baterías."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"2× lingote de oro, 2× polvo de redstone"
	]
	"quest.5DF7002A0B1098A5.title": "Lingote de adamantio"
	"quest.5DF7002A0B1098A5.quest_desc": [
		"El adamantio es un metal avanzado. También se puede obtener en la fundición con una gema de diamante y un lingote de níquel."
		""
		"&6Receta de crafteo&r &7(sin forma; en REI pulsa R sobre el objeto para verla)&f"
		"bloque de adamantio"
	]
	"quest.7D9BFF8F6D222F12.title": "Pipe Wrench"
	"quest.7D9BFF8F6D222F12.quest_desc": [
		"Llave para tuberías (Pipe Wrench). Se hace con lingotes de acero y de níquel."
		""
		"&6Receta de crafteo&r &7(con forma; en REI pulsa R sobre el objeto para verla)&f"
		"3× lingote de acero, lingote de níquel"
	]
	"quest.1ED5C9694AF9CA1E.title": "Lingote de níquel"
	"quest.1ED5C9694AF9CA1E.quest_desc": [
		"El níquel es un metal básico de Oritech (marcos, bobinas, tuberías...). Se obtiene fundiendo níquel en bruto, que sale de las menas de níquel. &aRecuerda:&f los minerales de Oritech solo aparecen en chunks nuevos."
		""
		"&6Receta de crafteo&r &7(en REI pulsa R sobre el objeto)&f"
		"bloque de níquel"
		""
		"&6En: Fundición&r"
		"Gema de níquel + Gema de níquel → 3× Lingote de níquel"
	]
	"quest.6ED72E5609C10122.title": "Lingote de platino"
	"quest.6ED72E5609C10122.quest_desc": [
